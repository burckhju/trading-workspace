TRADING_WORKSPACE_APPLICATION_NAME=Trading Workspace API
TRADING_WORKSPACE_ENVIRONMENT=development
TRADING_WORKSPACE_DEBUG=false
TRADING_WORKSPACE_LOG_LEVEL=INFO
TRADING_WORKSPACE_DOCUMENTATION_ENABLED=true
TRADING_WORKSPACE_DATABASE_URL=postgresql+asyncpg://trading_workspace:change-me@localhost:5432/trading_workspace
TRADING_WORKSPACE_DATABASE_ECHO=false
TRADING_WORKSPACE_DATABASE_POOL_SIZE=5
TRADING_WORKSPACE_DATABASE_MAX_OVERFLOW=10
TRADING_WORKSPACE_DATABASE_POOL_RECYCLE_SECONDS=1800

# Optional EODHD transport configuration
TRADING_WORKSPACE_MARKET_DATA__EODHD__ENABLED=false
TRADING_WORKSPACE_MARKET_DATA__EODHD__BASE_URL=https://eodhd.com/api
TRADING_WORKSPACE_MARKET_DATA__EODHD__API_KEY=
TRADING_WORKSPACE_MARKET_DATA__EODHD__CONNECT_TIMEOUT_SECONDS=5
TRADING_WORKSPACE_MARKET_DATA__EODHD__READ_TIMEOUT_SECONDS=15
TRADING_WORKSPACE_MARKET_DATA__EODHD__WRITE_TIMEOUT_SECONDS=5
TRADING_WORKSPACE_MARKET_DATA__EODHD__POOL_TIMEOUT_SECONDS=5
TRADING_WORKSPACE_MARKET_DATA__EODHD__DAILY_CALL_LIMIT=100000
TRADING_WORKSPACE_MARKET_DATA__EODHD__DAILY_CALL_SAFETY_RESERVE=1000
TRADING_WORKSPACE_MARKET_DATA__EODHD__REQUESTS_PER_MINUTE=1000
TRADING_WORKSPACE_MARKET_DATA__EODHD__HISTORICAL_EOD_CALL_COST=1
TRADING_WORKSPACE_MARKET_DATA__EODHD__HISTORICAL_CACHE_TTL_SECONDS=86400
TRADING_WORKSPACE_MARKET_DATA__EODHD__LATEST_CACHE_TTL_SECONDS=900
TRADING_WORKSPACE_MARKET_DATA__EODHD__RETRY_MAX_ATTEMPTS=3
TRADING_WORKSPACE_MARKET_DATA__EODHD__RETRY_BASE_DELAY_SECONDS=0.5
TRADING_WORKSPACE_MARKET_DATA__EODHD__RETRY_MAX_RETRY_AFTER_SECONDS=30
TRADING_WORKSPACE_MARKET_DATA__EODHD__RETRY_TOTAL_TIMEOUT_SECONDS=45
TRADING_WORKSPACE_MARKET_DATA__EODHD__RATE_LIMIT_BURST_CAPACITY=10

# Optional outbound-only Telegram delivery configuration
TRADING_WORKSPACE_NOTIFICATION__TELEGRAM__ENABLED=false
TRADING_WORKSPACE_NOTIFICATION__TELEGRAM__BASE_URL=https://api.telegram.org
TRADING_WORKSPACE_NOTIFICATION__TELEGRAM__BOT_TOKEN=
TRADING_WORKSPACE_NOTIFICATION__TELEGRAM__CHAT_ID=
TRADING_WORKSPACE_NOTIFICATION__TELEGRAM__TIMEOUT_SECONDS=10
TRADING_WORKSPACE_NOTIFICATION__TELEGRAM__MAX_ATTEMPTS=3
