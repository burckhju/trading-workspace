TRADING_WORKSPACE_APPLICATION_NAME=Trading Workspace API
TRADING_WORKSPACE_ENVIRONMENT=development
TRADING_WORKSPACE_DEBUG=false
TRADING_WORKSPACE_LOG_LEVEL=INFO
TRADING_WORKSPACE_DOCUMENTATION_ENABLED=true
TRADING_WORKSPACE_DATABASE_URL=postgresql+asyncpg://trading_workspace:change-me@localhost:5432/trading_workspace
TRADING_WORKSPACE_DATABASE_ECHO=false
TRADING_WORKSPACE_DATABASE_POOL_SIZE=5
TRADING_WORKSPACE_DATABASE_MAX_OVERFLOW=10
TRADING_WORKSPACE_DATABASE_POOL_RECYCLE_SECONDS=1800
