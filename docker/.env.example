POSTGRES_DB=trading_workspace
POSTGRES_USER=trading_workspace
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Docker Compose always targets the database service by default. Use this Docker-only
# override only when the backend container intentionally connects somewhere else.
TRADING_WORKSPACE_DOCKER_DATABASE_URL=
TRADING_WORKSPACE_APPLICATION_NAME=Trading Workspace API
TRADING_WORKSPACE_ENVIRONMENT=development
TRADING_WORKSPACE_DEBUG=false
TRADING_WORKSPACE_LOG_LEVEL=INFO
TRADING_WORKSPACE_DOCUMENTATION_ENABLED=true
TRADING_WORKSPACE_DATABASE_ECHO=false
TRADING_WORKSPACE_DATABASE_POOL_SIZE=5
TRADING_WORKSPACE_DATABASE_MAX_OVERFLOW=10
TRADING_WORKSPACE_DATABASE_POOL_RECYCLE_SECONDS=1800

# Optional EODHD transport configuration
TRADING_WORKSPACE_MARKET_DATA__EODHD__ENABLED=false
TRADING_WORKSPACE_MARKET_DATA__EODHD__BASE_URL=https://eodhd.com/api
TRADING_WORKSPACE_MARKET_DATA__EODHD__API_KEY=
TRADING_WORKSPACE_MARKET_DATA__VONTOBEL_MARKETS__ENABLED=false
TRADING_WORKSPACE_MARKET_DATA__VONTOBEL_MARKETS__BASE_URL=https://markets.vontobel.com
TRADING_WORKSPACE_MARKET_DATA__VONTOBEL_MARKETS__CULTURE=de-de
TRADING_WORKSPACE_MARKET_DATA__VONTOBEL_MARKETS__TIMEOUT_SECONDS=15

# Optional Börse Stuttgart XSTU delayed quote source.
# source_mode=index uses the official HTML index (may be blocked by Cloudflare).
# source_mode=local_directory reads the newest XSTU-pretrade-*.json.gz from the mounted directory.
# source_mode=direct_url reads a trusted HTTPS endpoint/mirror that serves the latest official gzip payload.
TRADING_WORKSPACE_MARKET_DATA__STUTTGART_DELAYED__ENABLED=false
TRADING_WORKSPACE_MARKET_DATA__STUTTGART_DELAYED__SOURCE_MODE=local_directory
TRADING_WORKSPACE_MARKET_DATA__STUTTGART_DELAYED__LOCAL_DIRECTORY=/var/lib/trading-workspace/xstu
TRADING_WORKSPACE_MARKET_DATA__STUTTGART_DELAYED__DIRECT_URL=
STUTTGART_DELAYED_SOURCE_DIRECTORY=./stuttgart-data

# Optional position-monitoring background runner (requires EODHD when enabled)
TRADING_WORKSPACE_POSITION_MONITORING__ENABLED=false
TRADING_WORKSPACE_POSITION_MONITORING__INTERVAL_SECONDS=900
TRADING_WORKSPACE_POSITION_MONITORING__MAX_COMPLETED_PRICE_AGE_DAYS=4
TRADING_WORKSPACE_POSITION_MONITORING__DELIVERY_RECOVERY_TIMEOUT_SECONDS=300

# Optional outbound-only Telegram delivery configuration
TRADING_WORKSPACE_NOTIFICATION__TELEGRAM__ENABLED=false
TRADING_WORKSPACE_NOTIFICATION__TELEGRAM__BASE_URL=https://api.telegram.org
TRADING_WORKSPACE_NOTIFICATION__TELEGRAM__BOT_TOKEN=
TRADING_WORKSPACE_NOTIFICATION__TELEGRAM__CHAT_ID=
TRADING_WORKSPACE_NOTIFICATION__TELEGRAM__TIMEOUT_SECONDS=10
TRADING_WORKSPACE_NOTIFICATION__TELEGRAM__MAX_ATTEMPTS=3

BACKEND_PORT=8000
FRONTEND_PORT=8080
VITE_API_BASE_URL=http://localhost:8080/api

# Automatic market-data discovery/refresh for active workspace master data.
# Reuses enabled providers; does not enable a subscription or place orders.
TRADING_WORKSPACE_MARKET_DATA__REFRESH__ENABLED=false
TRADING_WORKSPACE_MARKET_DATA__REFRESH__WARRANTS_INTERVAL_SECONDS=300
TRADING_WORKSPACE_MARKET_DATA__REFRESH__UNDERLYINGS_INTERVAL_SECONDS=3600
TRADING_WORKSPACE_MARKET_DATA__REFRESH__DISCOVERY_INTERVAL_SECONDS=3600
TRADING_WORKSPACE_MARKET_DATA__REFRESH__REQUEST_SPACING_SECONDS=15
TRADING_WORKSPACE_MARKET_DATA__REFRESH__AUTO_CONFIGURE=true
