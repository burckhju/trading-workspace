# Public Frankfurt website JSON: LAST TRADE ONLY, no bid/ask or execution approval.
# Copy to docker/frankfurt.env only if absent; see docs/frankfurt-quotes.md.
# Review intended usage before enabling. No subscription/key is created.
TRADING_WORKSPACE_MARKET_DATA__FRANKFURT__ENABLED=false
TRADING_WORKSPACE_MARKET_DATA__FRANKFURT__USAGE_APPROVED=false
TRADING_WORKSPACE_MARKET_DATA__FRANKFURT__CONTRACT_VERIFIED=false
TRADING_WORKSPACE_MARKET_DATA__FRANKFURT__SOURCE_MODE=public_website
TRADING_WORKSPACE_MARKET_DATA__FRANKFURT__SOURCE_NAME=deutsche-boerse-public
TRADING_WORKSPACE_MARKET_DATA__FRANKFURT__MAX_QUOTE_AGE_SECONDS=900
TRADING_WORKSPACE_MARKET_DATA__FRANKFURT__REFRESH_INTERVAL_SECONDS=15
# Leave SNAPSHOT_URL, ALLOWED_HOST, BEARER_TOKEN and LOCAL_FILE unset in this mode.
